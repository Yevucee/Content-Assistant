# Copy to .env and adjust. Never commit .env.

# Database (default: SQLite file under ./data/)
DATABASE_URL=sqlite+aiosqlite:///./data/harness.db

# OpenAI-compatible API (local LM or cloud)
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://127.0.0.1:9888/v1
DEFAULT_MODEL=local-8b

# App
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# Brand packs root (default: ./brands from repo root)
# BRANDS_ROOT=

# Source ingestion (optional)
# SOURCE_FETCH_TIMEOUT=20
# SOURCE_RSS_MAX_ENTRIES=25
# SOURCE_MAX_TOTAL_ITEMS=80
# SOURCE_USER_AGENT=ContentHarness/0.2

# Skip LLM for topic discovery (use heuristics only — useful offline)
# SKIP_TOPIC_LLM=0

# Skip LLM for editorial/article/channel/review (structured fallbacks only)
# SKIP_CONTENT_LLM=0
# CONTENT_MAX_TOKENS=4096

# Scheduler (worker): optional Cron "min hour dom mon dow" (space-separated)
# Leave empty in dev to disable in-process weekly jobs.
WEEKLY_CRON=
# DISABLE_SCHEDULER=1

# Optional: WordPress Application Password vars (names must match brands/*/brand.yaml wordpress.*_env)
# WORDPRESS_USERNAME_ONIX=
# WORDPRESS_APP_PASSWORD_ONIX=
# WORDPRESS_USERNAME_INVENTIVE_AFRICA=
# WORDPRESS_APP_PASSWORD_INVENTIVE_AFRICA=
# WORDPRESS_USERNAME_TUCKER=
# WORDPRESS_APP_PASSWORD_TUCKER=
# WORDPRESS_USERNAME=
# WORDPRESS_APPLICATION_PASSWORD=
